---
// A mini render of the desktop app: a frameless macOS window with the sidebar
// and the chat, hand-built from site tokens so it matches the real product.
// Purely decorative (the real copy lives in the feature list); each feature
// gets one scripted scene, activated and replayed by features.astro's script.
// Base styles are every scene's FINAL state; animations exist only under
// `.is-active`, so no-JS and reduced-motion visitors see finished scenes.
import { features } from "../content/site";
import { buildSceneTimeline } from "../lib/scene-timeline";
import Icon from "./icons.astro";

const scenes = features.map((feature) => ({ demo: feature.demo, timeline: buildSceneTimeline(feature.demo) }));
---

<div class="fdemo w-full overflow-hidden rounded-2xl border border-line bg-bg shadow-xl">
  <div class="flex gap-2 border-b border-line px-4 py-3.5">
    <span class="size-3 rounded-full bg-[#ff5f57]"></span>
    <span class="size-3 rounded-full bg-[#febc2e]"></span>
    <span class="size-3 rounded-full bg-[#28c840]"></span>
  </div>
  <div class="flex h-[30rem] max-h-[calc(85vh-3rem)]">
    <aside class="hidden w-44 shrink-0 flex-col border-r border-line bg-surface p-2.5 text-xs xl:flex">
      <div class="flex h-7 items-center justify-center gap-1.5 rounded-full border border-line bg-bg font-medium">
        <Icon name="plus" class="size-3.5" />
        New Chat
      </div>
      <div class="mt-3 flex flex-col gap-0.5">
        {
          features.map((feature, i) => (
            <div data-chat={i} class:list={["truncate rounded-lg px-2 py-1.5", i === 0 && "is-active"]}>
              {feature.demo.chatTitle}
            </div>
          ))
        }
      </div>
      <div class="mt-auto flex flex-col gap-0.5">
        <div class="flex items-center gap-2 rounded-lg px-2 py-1.5">
          <Icon name="receipt" class="size-3.5 text-ink-2" />
          Transactions
        </div>
        <div class="flex items-center gap-2 rounded-lg px-2 py-1.5">
          <Icon name="wallet" class="size-3.5 text-ink-2" />
          Net Worth
          <span class="ml-auto font-mono text-[10px] text-ink-2">86K EUR</span>
        </div>
        <div class="flex items-center gap-2 rounded-lg px-2 py-1.5">
          <Icon name="settings" class="size-3.5 text-ink-2" />
          Settings
        </div>
      </div>
    </aside>
    <div class="relative min-w-0 flex-1">
      {
        scenes.map(({ demo, timeline }, i) => (
          <div data-scene={i} class:list={["scene absolute inset-0 flex-col overflow-hidden p-4", i === 0 && "is-shown"]}>
            {demo.user && (
              <div data-fx style={`--d:${timeline.sendAt ?? 0}ms`} class="flex flex-col items-end gap-2">
                {demo.user.attachment && (
                  <div class="flex w-56 items-center gap-2.5 rounded-xl border border-line bg-surface p-2.5">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-2">
                      <Icon name="file" class="size-4 text-ink-2" />
                    </span>
                    <span class="min-w-0">
                      <span class="block truncate text-xs font-medium">{demo.user.attachment.name}</span>
                      <span class="block text-[10px] text-ink-2">{demo.user.attachment.meta}</span>
                    </span>
                  </div>
                )}
                <div class="max-w-[85%] rounded-3xl bg-surface-2/60 px-3.5 py-2 text-sm leading-relaxed">{demo.user.text}</div>
              </div>
            )}
            {demo.working && (
              <div class="mt-3">
                <div class="relative w-fit text-sm text-ink-2" style={`--t-done:${timeline.doneAt ?? 0}ms`}>
                  <span class="fx-worked">Worked for {demo.working.duration}</span>
                  <span class="fx-working absolute inset-y-0 left-0" style={`--d:${timeline.workingAt ?? 0}ms`}>
                    Working
                  </span>
                </div>
                {demo.working.steps.length > 0 && (
                  <ol data-fx style={`--d:${timeline.stepDelays[0] ?? timeline.workingAt ?? 0}ms`} class="mt-1.5 flex flex-col gap-1.5 border-l border-line pl-3.5">
                    {demo.working.steps.map((step, si) => (
                      <li
                        data-fx
                        style={`--d:${timeline.stepDelays[si]}ms`}
                        class="flex items-center gap-1.5 text-xs text-ink-2"
                      >
                        <Icon name="check" class="size-3 shrink-0 text-accent-ink" />
                        {step}
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            )}
            {demo.reply && (
              <div class="mt-3 min-h-0 text-sm">
                <p class="leading-relaxed">
                  {demo.reply.text
                    .split(/\s+/)
                    .filter(Boolean)
                    .map((word, wi) => (
                      <span class="fx-stream" style={`--d:${timeline.replyWordDelays[wi]}ms`}>{`${word} `}</span>
                    ))}
                </p>
                {demo.reply.chips && (
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {demo.reply.chips.map((chip, ci) => (
                      <span data-fx style={`--d:${timeline.chipDelays[ci]}ms`} class:list={["chip", `chip-${chip.kind}`]}>
                        {chip.label}
                      </span>
                    ))}
                  </div>
                )}
                {demo.reply.table && (
                  <div data-fx style={`--d:${timeline.rowDelays[0] ?? timeline.replyAt ?? 0}ms`} class="mt-2.5 overflow-hidden rounded-lg border border-line">
                    <table class="w-full text-xs">
                      <thead>
                        <tr class="bg-surface-2/60">
                          {demo.reply.table.head.map((heading, hi) => (
                            <th class:list={["px-2.5 py-1.5 font-medium", hi > 0 ? "text-right" : "text-left"]}>
                              {heading}
                            </th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {demo.reply.table.rows.map((row, ri) => (
                          <tr data-fx style={`--d:${timeline.rowDelays[ri]}ms`} class="border-t border-line">
                            {row.map((cell, ci) => (
                              <td class:list={["px-2.5 py-1.5", ci > 0 && "text-right font-mono"]}>{cell}</td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}
            <div class="mt-auto pt-3">
              {demo.composer?.models && (
                <div class="relative">
                  <div data-fx style={`--d:${timeline.modelDelays[0] ?? 0}ms`} class="absolute bottom-2 left-1 z-10 w-56 rounded-xl border border-line bg-bg p-1 shadow-lg">
                    {demo.composer.models.map((model, mi) => (
                      <div
                        data-fx
                        style={`--d:${timeline.modelDelays[mi]}ms`}
                        class:list={[
                          "flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-xs",
                          mi === 0 && "bg-surface-2/60",
                        ]}
                      >
                        <span class="font-medium">{model.name}</span>
                        {model.note && <span class="text-[10px] text-ink-2">{model.note}</span>}
                        {mi === 0 && <Icon name="check" class="ml-auto size-3 text-accent-ink" />}
                      </div>
                    ))}
                  </div>
                </div>
              )}
              <div
                class="rounded-3xl border border-line bg-surface-2/60 px-3.5 pt-3 pb-2.5"
                style={
                  demo.user &&
                  `--t-type:${timeline.typeCharDelays[0] ?? timeline.sendAt ?? 0}ms; --t-send:${timeline.sendAt ?? 0}ms`
                }
              >
                {demo.user?.attachment && (
                  <div
                    class="fx-cattach mb-2.5 w-56 items-center gap-2.5 rounded-xl border border-line bg-bg p-2.5"
                    style={`--d:${timeline.attachmentAt ?? 0}ms`}
                  >
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-2">
                      <Icon name="file" class="size-4 text-ink-2" />
                    </span>
                    <span class="min-w-0">
                      <span class="block truncate text-xs font-medium">{demo.user.attachment.name}</span>
                      <span class="block text-[10px] text-ink-2">{demo.user.attachment.meta}</span>
                    </span>
                  </div>
                )}
                <div class="relative text-sm">
                  <div class:list={["text-ink-2", demo.user && "fx-placeholder"]}>Write a message...</div>
                  {demo.user && (
                    <div class="fx-typed absolute inset-0 overflow-hidden whitespace-pre">
                      {[...demo.user.text.trim()].map((ch, ci) => (
                        <span class="fx-char" style={`--d:${timeline.typeCharDelays[ci]}ms`}>{ch}</span>
                      ))}
                    </div>
                  )}
                </div>
                <div class="mt-4 flex items-center justify-between">
                  <div class="flex items-center gap-2 text-ink-2">
                    <Icon name="paperclip" class="size-4" />
                    <span class="flex items-center gap-1 text-xs font-medium">
                      Opus 5
                      <Icon name="chevron-down" class="size-3.5 opacity-60" />
                    </span>
                  </div>
                  <span
                    class:list={[
                      "flex size-7 items-center justify-center rounded-full bg-accent text-on-accent",
                      demo.user && "fx-send",
                    ]}
                  >
                    <Icon name="arrow-up" class="size-4" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  /* Global on purpose: `is-shown`/`is-active` are toggled at runtime by
     features.astro's script, and Astro's scoped styles don't cover keyframes
     cleanly; everything is namespaced under .fdemo instead. Base styles are
     the final state of a scene; animations exist only under `.is-active`, and
     every one is `both`/`forwards`-filled, so the global reduced-motion rule
     (global.css) collapses an active scene to that same final state. */
  .fdemo .scene {
    display: none;
  }
  .fdemo .scene.is-shown {
    display: flex;
  }

  /* The sidebar chat that matches the active scene. */
  .fdemo [data-chat].is-active {
    background: var(--surface-2);
  }

  @keyframes fdemo-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes fdemo-hide {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes fdemo-shimmer {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -150% 0;
    }
  }

  .fdemo .scene.is-active [data-fx] {
    animation: fdemo-in 250ms var(--d, 0ms) both;
  }

  /* Assistant reply words: token-stream feel, a fast fade with no movement. */
  @keyframes fdemo-stream {
    from {
      opacity: 0;
    }
  }
  .fdemo .scene.is-active .fx-stream {
    animation: fdemo-stream 180ms var(--d, 0ms) both;
  }

  /* Composer typing: the typed text overlays the placeholder from the first
     character (--t-type) until the send (--t-send), when the composer clears,
     the send button presses, and the bubble lands in the thread. */
  @keyframes fdemo-show {
    from {
      opacity: 0;
      visibility: visible;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }
  @keyframes fdemo-press {
    50% {
      transform: scale(0.85);
    }
  }
  .fdemo .fx-typed,
  .fdemo .fx-cattach {
    display: none;
  }
  .fdemo .scene.is-active .fx-typed {
    display: block;
    animation: fdemo-hide 1ms var(--t-send, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-char {
    animation: fdemo-stream 1ms var(--d, 0ms) both;
  }
  /* On send the card must also give up its layout space, not just fade, or
     the composer keeps a blank block where it used to be. */
  @keyframes fdemo-collapse {
    to {
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      margin-bottom: 0;
      padding-top: 0;
      padding-bottom: 0;
      border-width: 0;
    }
  }
  .fdemo .scene.is-active .fx-cattach {
    display: flex;
    max-height: 5rem;
    overflow: hidden;
    animation:
      fdemo-in 200ms var(--d, 0ms) both,
      fdemo-collapse 1ms var(--t-send, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-placeholder {
    animation:
      fdemo-hide 1ms var(--t-type, 0ms) forwards,
      fdemo-show 150ms var(--t-send, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-send {
    animation: fdemo-press 250ms var(--t-send, 0ms) both;
  }

  /* "Working" exists only while the scene animates; the final state shows
     "Worked for Ns". The shimmer sweeps the label until --t-done hides it. */
  .fdemo .fx-working {
    display: none;
  }
  .fdemo .scene.is-active .fx-working {
    display: inline-block;
    background-image: linear-gradient(90deg, var(--ink-2) 40%, var(--ink) 50%, var(--ink-2) 60%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      fdemo-in 200ms var(--d, 0ms) both,
      fdemo-shimmer 1.4s linear infinite,
      fdemo-hide 1ms var(--t-done, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-worked {
    animation: fdemo-in 200ms var(--t-done, 0ms) both;
  }

  /* Entity chips, the app's dusty per-kind colors (hardcoded there too). */
  .fdemo .chip {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.1rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .fdemo .chip-account {
    background: #d4def0;
    color: #3f5685;
  }
  .fdemo .chip-payee {
    background: #d2e8db;
    color: #3f6e55;
  }
  .fdemo .chip-tag {
    background: #efe1cd;
    color: #856b41;
  }
  .fdemo .chip-skill {
    background: #e2dcee;
    color: #5c4a82;
  }
  @media (prefers-color-scheme: dark) {
    .fdemo .chip-account {
      background: #2c3850;
      color: #a7bdde;
    }
    .fdemo .chip-payee {
      background: #293d31;
      color: #a3c9b1;
    }
    .fdemo .chip-tag {
      background: #3f3626;
      color: #d8c096;
    }
    .fdemo .chip-skill {
      background: #342c47;
      color: #bcaedd;
    }
  }
</style>
