---
// The features section's app window: one scene per feature, the sidebar
// listing every feature's chat. features.astro's script shows and replays
// the scene of the feature in view. Decorative; the real copy lives in the
// feature list.
import { features } from "../content/site";
import { buildSceneTimeline } from "../lib/scene-timeline";
import MockScene from "./mock-scene.astro";
import MockWindow from "./mock-window.astro";
---

<MockWindow chats={features.map((feature) => feature.demo.chatTitle)}>
  {
    features.map((feature, i) => (
      <MockScene index={i} shown={i === 0} turns={[{ demo: feature.demo, timeline: buildSceneTimeline(feature.demo) }]} />
    ))
  }
</MockWindow>
