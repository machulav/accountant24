---
// The app's frameless macOS window: inset traffic lights, the sidebar (New
// Chat, the chat list, Transactions / Net Worth / Settings) and a slot for
// the scenes. Decorative; shared by the hero demo and the features mock. The
// sidebar lists every chat on the page; selecting one scrolls to the section
// that plays it.
import type { PageChat } from "../lib/page-chats";
import Icon from "./icons.astro";

interface Props {
  chats: PageChat[];
  /** The target of the chat shown as selected. */
  activeChat: string;
  class?: string;
  /** Height classes for the window body. */
  height?: string;
}
const { chats, activeChat, class: className = "", height = "h-[30rem] max-h-[calc(85vh-3rem)]" } = Astro.props;
---

<div class:list={["fdemo relative w-full overflow-hidden rounded-2xl border border-line bg-bg shadow-xl", className]}>
  <!-- No title bar, like the app: the traffic lights sit inset over the sidebar. -->
  <div class="absolute top-3.5 left-3.5 z-10 flex gap-2">
    <span class="size-3 rounded-full bg-[#ff5f57]"></span>
    <span class="size-3 rounded-full bg-[#febc2e]"></span>
    <span class="size-3 rounded-full bg-[#28c840]"></span>
  </div>
  <div class:list={["flex", height]}>
    <aside class="hidden w-48 shrink-0 flex-col border-r border-line-soft bg-surface p-2 pt-11 text-xs xl:flex">
      <div class="flex h-7 items-center justify-center gap-1.5 rounded-full border border-line bg-bg font-medium">
        <Icon name="plus" class="size-3.5" />
        New Chat
      </div>
      <div class="mt-4 flex flex-col gap-0.5">
        {
          chats.map((chat) => (
            <a
              href={`#${chat.target}`}
              data-chat={chat.target}
              class:list={["block truncate rounded-full px-3 py-1.5", chat.target === activeChat && "is-active"]}
            >
              {chat.title}
            </a>
          ))
        }
      </div>
      <div class="mt-auto flex flex-col gap-0.5">
        <div class="flex items-center gap-2 rounded-full px-3 py-1.5">
          <Icon name="receipt" class="size-3.5 text-ink-2" />
          Transactions
        </div>
        <div class="flex items-center gap-2 rounded-full px-3 py-1.5">
          <Icon name="wallet" class="size-3.5 text-ink-2" />
          Net Worth
          <span class="ml-auto font-mono text-[10px] text-ink-2">86K USD</span>
        </div>
        <div class="flex items-center gap-2 rounded-full px-3 py-1.5">
          <Icon name="settings" class="size-3.5 text-ink-2" />
          Settings
        </div>
      </div>
    </aside>
    <div class="relative min-w-0 flex-1">
      <slot />
    </div>
  </div>
</div>

<style is:global>
  /* The sidebar chat that matches the shown scene. */
  .fdemo [data-chat].is-active {
    background: var(--surface-2);
    font-weight: 500;
  }
  .fdemo [data-chat]:not(.is-active):hover {
    background: color-mix(in oklch, var(--surface-2) 55%, transparent);
  }
</style>

<script>
  // Selecting a chat scrolls its section to the viewport's center: for a
  // feature that is where the features section's scroll script activates
  // it. The anchor's own jump stays as the no-JS fallback.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const chat of document.querySelectorAll<HTMLAnchorElement>(".fdemo [data-chat]")) {
    chat.addEventListener("click", (event) => {
      const target = document.getElementById(chat.dataset.chat ?? "");
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ block: "center", behavior: reducedMotion.matches ? "instant" : "smooth" });
    });
  }
</script>
