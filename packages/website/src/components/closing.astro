---
import { site } from "../content/site";
import Icon from "./icons.astro";
---

<section class="mx-auto max-w-6xl px-6 pt-6 pb-16 lg:pt-0 lg:pb-24" aria-labelledby="closing-title">
  <div class="rounded-3xl bg-ink px-6 py-12 text-center text-bg sm:px-12 lg:py-16">
    <h2 id="closing-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Try it with your next receipt
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-lg text-bg/70 text-pretty">
      Download, connect an LLM, and log your first transaction in minutes.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={site.downloadUrl} data-track="download_clicked" data-placement="closing" class="btn btn-primary">
        <Icon name="download" />
        Download for macOS
      </a>
      <a
        href={site.github}
        data-track="github_clicked"
        data-placement="closing"
        class="btn border border-bg/20 text-bg hover:bg-bg/10"
      >
        <Icon name="github" />
        Star on GitHub
      </a>
    </div>
  </div>
</section>
