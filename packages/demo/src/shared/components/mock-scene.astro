---
import { replyTokens, type SceneTimeline } from "../timeline";
// One scripted scene inside the app window: a thread of one or two turns
// (the user types into the composer, maybe picking a skill from the `/`
// popup first, and sends, the agent works, the reply streams in) or a
// composer-only scene (an open model menu). Every animated
// element carries its moment as an inline `--d`; the CSS below plays them
// under `.is-active` only. Base styles are the FINAL state, so no-JS and
// reduced-motion visitors see the finished conversation.
import type { SceneDemo } from "../types";
import Icon from "./icons.astro";

interface Turn {
  demo: SceneDemo;
  timeline: SceneTimeline;
}

interface Props {
  turns: Turn[];
  index: number;
  shown?: boolean;
}

const { turns, index, shown = false } = Astro.props;

// The composer types every turn's message in sequence; the placeholder and
// send-button animations below know about two turns at most.
const typed = turns.filter((turn) => turn.demo.user);
if (typed.length > 2) throw new Error("A mock scene plays at most two typed turns.");
const typeStart = (timeline: SceneTimeline) => timeline.slashAt ?? timeline.typeCharDelays[0] ?? timeline.sendAt ?? 0;
const composerVars = typed
  .flatMap((turn, i) => {
    const suffix = i === 0 ? "" : "-2";
    return [`--t-type${suffix}:${typeStart(turn.timeline)}ms`, `--t-send${suffix}:${turn.timeline.sendAt ?? 0}ms`];
  })
  .join("; ");
const menuTurn = turns.find((turn) => turn.demo.composer?.models);

/** A skill's full name, `plugin:skill`, with the plugin part played down
 *  like the app's picker does; split on the first colon only. */
function skillName(name: string): { plugin: string; skill: string } {
  const colon = name.indexOf(":");
  return colon < 0 ? { plugin: "", skill: name } : { plugin: name.slice(0, colon + 1), skill: name.slice(colon + 1) };
}

// A streamed word of reply prose: plain text, or a mention rendered as an
// inline chip like the app does (`:payee[Trader Joe's]`).
interface Token {
  word: string;
  /** `after` is punctuation glued to the mention, rendered right after the chip. */
  chip?: { kind: string; label: string; after: string };
  index: number;
}
function toToken(word: string, index: number): Token {
  const mention = word.match(/^:(account|payee|tag|skill)\[([^\]]+)\](\S*)$/);
  return mention ? { word, chip: { kind: mention[1], label: mention[2], after: mention[3] }, index } : { word, index };
}
// Reply prose as paragraphs (split on blank lines) of words, each word
// carrying its index in the whole text so it streams at the timeline's delay.
function replyParagraphs(text: string): Token[][] {
  let index = 0;
  return text
    .split(/\n{2,}/)
    .map((paragraph) => replyTokens(paragraph).map((word) => toToken(word, index++)))
    .filter((paragraph) => paragraph.length > 0);
}
---

<div data-scene={index} class:list={["scene absolute inset-0 flex-col p-4 pt-0", shown && "is-shown"]}>
  {/* The thread reaches the window's top edge so a scrolled-off message is
      cut at the border, like the app; its top padding clears the window's
      inset traffic lights when the sidebar is hidden. overflow-hidden keeps
      the visitor from scrolling it; the hero script still scrolls it to
      follow a new turn (scrollTo works on hidden overflow). */}
  <div data-thread class="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden pt-8">
    {
      turns.map(({ demo, timeline }, ti) => (
        <Fragment>
          {demo.user && (
            <div
              data-fx
              style={`--d:${timeline.sendAt ?? 0}ms`}
              class:list={["flex shrink-0 flex-col items-end gap-2", ti > 0 && "mt-3"]}
            >
              {demo.user.attachments && (
                <div class="flex flex-wrap justify-end gap-2">
                  {demo.user.attachments.map((attachment) => (
                    <div class="flex w-44 items-center gap-2.5 rounded-xl border border-line bg-surface p-2.5">
                      <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-2">
                        <Icon name="file" class="size-4 text-ink-2" />
                      </span>
                      <span class="min-w-0">
                        <span class="block truncate text-xs font-medium">{attachment.name}</span>
                        <span class="block text-[10px] text-ink-2">{attachment.meta}</span>
                      </span>
                    </div>
                  ))}
                </div>
              )}
              {/* A bubble holding only a chip hugs it with the same small
                  padding on every side, and lays it out as a flex item: as
                  inline content the pill would float in the prose line box
                  and the template whitespace after it would render as a
                  trailing space, leaving it off-center. */}
              <div
                class:list={[
                  "max-w-[85%] rounded-3xl bg-surface-2/60 text-sm leading-relaxed",
                  demo.user.skill && !demo.user.text.trim() ? "flex p-1.5" : "px-3.5 py-2",
                ]}
              >
                {demo.user.skill && (
                  <Fragment>
                    <span class="chip chip-skill gap-1 align-baseline">
                      <Icon name="zap" class="size-3" />
                      {demo.user.skill.picked}
                    </span>
                    {demo.user.text.trim() && " "}
                  </Fragment>
                )}
                {demo.user.text}
              </div>
            </div>
          )}
          {demo.working && (
            <div class="shrink-0">
              <div class="relative w-fit text-sm text-ink-2" style={`--t-done:${timeline.doneAt ?? 0}ms`}>
                <span class="fx-worked">Worked for {demo.working.duration}</span>
                <span class="fx-working absolute inset-y-0 left-0" style={`--d:${timeline.workingAt ?? 0}ms`}>
                  Working
                </span>
              </div>
              {/* Each step carries its own piece of the rail, so the line grows
                  with the steps instead of standing at full height from the start. */}
              {demo.working.steps.length > 0 && (
                <ol class="mt-1.5 flex flex-col">
                  {demo.working.steps.map((step, si) => (
                    <li
                      data-fx
                      style={`--d:${timeline.stepDelays[si]}ms`}
                      class="flex items-center gap-1.5 border-l border-line py-[3px] pl-3.5 text-xs text-ink-2"
                    >
                      <Icon name="check" class="size-3 shrink-0 text-accent-ink" />
                      {step}
                    </li>
                  ))}
                </ol>
              )}
            </div>
          )}
          {demo.reply && (
            <div class="shrink-0 text-sm">
              {/* text-pretty: the thread is narrow, and a last line holding
                  one word looks like a mistake in a demo. */}
              {replyParagraphs(demo.reply.text).map((paragraph) => (
                <p class="text-pretty leading-relaxed [&+p]:mt-2">
                  {paragraph.map(({ word, chip, index }) =>
                    chip ? (
                      <Fragment>
                        <span class="whitespace-nowrap">
                          <span
                            class:list={["fx-stream chip align-baseline", `chip-${chip.kind}`]}
                            style={`--d:${timeline.replyWordDelays[index]}ms`}
                          >
                            {chip.label}
                          </span>
                          <span class="fx-stream" style={`--d:${timeline.replyWordDelays[index]}ms`}>{chip.after}</span>
                        </span>{" "}
                      </Fragment>
                    ) : (
                      <span class="fx-stream" style={`--d:${timeline.replyWordDelays[index]}ms`}>{`${word} `}</span>
                    ),
                  )}
                </p>
              ))}
              {demo.reply.bullets && (
                <ul class="mt-2 flex flex-col gap-1 pl-4">
                  {demo.reply.bullets.map((bullet, bi) => (
                    <li
                      data-fx
                      style={`--d:${timeline.bulletWordDelays[bi]?.[0] ?? 0}ms`}
                      class="list-disc text-pretty leading-relaxed marker:text-ink-2"
                    >
                      {replyTokens(bullet).map((word, wi) => {
                        const { chip } = toToken(word, wi);
                        const delay = `--d:${timeline.bulletWordDelays[bi]?.[wi]}ms`;
                        return chip ? (
                          <Fragment>
                            <span class="whitespace-nowrap">
                              <span class:list={["fx-stream chip align-baseline", `chip-${chip.kind}`]} style={delay}>
                                {chip.label}
                              </span>
                              <span class="fx-stream" style={delay}>
                                {chip.after}
                              </span>
                            </span>{" "}
                          </Fragment>
                        ) : (
                          <span class="fx-stream" style={delay}>{`${word} `}</span>
                        );
                      })}
                    </li>
                  ))}
                </ul>
              )}
              {demo.reply.chips && (
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {demo.reply.chips.map((chip, ci) => (
                    <span data-fx style={`--d:${timeline.chipDelays[ci]}ms`} class:list={["chip", `chip-${chip.kind}`]}>
                      {chip.label}
                    </span>
                  ))}
                </div>
              )}
              {demo.reply.table && (
                <div
                  data-fx
                  style={`--d:${timeline.rowDelays[0] ?? timeline.replyAt ?? 0}ms`}
                  class="mt-2.5 overflow-hidden rounded-lg border border-line"
                >
                  <table class="w-full text-xs">
                    <thead>
                      <tr class="bg-surface-2/60">
                        {demo.reply.table.head.map((heading, hi) => (
                          <th class:list={["px-2.5 py-1.5 font-medium", hi > 0 ? "text-right" : "text-left"]}>{heading}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {demo.reply.table.rows.map((row, ri) => (
                        <tr data-fx style={`--d:${timeline.rowDelays[ri]}ms`} class="border-t border-line">
                          {row.map((cell, ci) => (
                            <td class:list={["px-2.5 py-1.5", ci > 0 && "text-right font-mono"]}>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          )}
        </Fragment>
      ))
    }
  </div>
  <div class="pt-3">
    {
      menuTurn?.demo.composer?.models && (
        <div class="relative">
          <div
            data-fx
            style={`--d:${menuTurn.timeline.modelDelays[0] ?? 0}ms`}
            class="absolute bottom-2 left-1 z-10 w-56 rounded-3xl bg-bg p-1.5 shadow-lg ring-1 ring-ink/5 dark:ring-ink/10"
          >
            {menuTurn.demo.composer.models.map((model, mi) => (
              <div
                data-fx
                style={`--d:${menuTurn.timeline.modelDelays[mi]}ms`}
                class:list={["flex items-center gap-2 rounded-2xl px-3 py-2 text-xs", mi === 0 && "bg-surface-2/60"]}
              >
                <span class="font-medium">{model.name}</span>
                {model.note && <span class="text-[10px] text-ink-2">{model.note}</span>}
                {mi === 0 && <Icon name="check" class="ml-auto size-3 text-accent-ink" />}
              </div>
            ))}
          </div>
        </div>
      )
    }
    {
      typed.map(({ demo, timeline }) => {
        const skill = demo.user?.skill;
        if (!skill) return null;
        const pickedIndex = skill.options.findIndex((option) => option.name === skill.picked);
        return (
          <div class="relative">
            {/* The app's `/` popover (its rounded-3xl chrome, rounded-2xl
                rows): flat rows, the zap glyph, the plugin prefix muted, the
                description under the name. The highlight
                starts on the first row and walks down to the picked one; the
                pick closes the popup, so its final state is hidden. */}
            <div
              class="fx-picker absolute bottom-2 left-1 z-10 w-80 rounded-3xl bg-bg p-1.5 shadow-lg ring-1 ring-ink/5 dark:ring-ink/10"
              style={`--d:${timeline.pickerAt ?? 0}ms; --t-pick:${timeline.pickAt ?? 0}ms`}
            >
              {skill.options.map((option, si) => (
                <div data-fx style={`--d:${timeline.skillDelays[si]}ms`} class="relative flex flex-col gap-0.5 px-3 py-2">
                  {si <= pickedIndex && (
                    <span
                      class="fx-highlight absolute inset-0 rounded-2xl bg-surface-2/60"
                      style={`--d:${timeline.highlightDelays[si]}ms${
                        timeline.highlightDelays[si + 1] === undefined ? "" : `; --t-off:${timeline.highlightDelays[si + 1]}ms`
                      }`}
                    />
                  )}
                  <span class="relative flex min-w-0 items-center gap-1.5 text-xs font-medium">
                    <Icon name="zap" class="size-3 shrink-0 text-ink-2" />
                    <span class="truncate">
                      <span class="font-normal text-ink-2">{skillName(option.name).plugin}</span>
                      {skillName(option.name).skill}
                    </span>
                  </span>
                  <span class="relative line-clamp-3 pl-[1.125rem] text-[10px] leading-tight text-ink-2">{option.description}</span>
                </div>
              ))}
            </div>
          </div>
        );
      })
    }
    <div class="rounded-3xl bg-surface-2/60 px-3.5 pt-3 pb-2.5" style={composerVars || undefined}>
      {
        typed.map(
          ({ demo, timeline }) =>
            demo.user?.attachments && (
              <div class="fx-cattach mb-2.5 flex-wrap gap-2" style={`--t-send:${timeline.sendAt ?? 0}ms`}>
                {demo.user.attachments.map((attachment, ai) => (
                  <div
                    data-fx
                    style={`--d:${timeline.attachmentDelays[ai]}ms`}
                    class="flex w-44 items-center gap-2.5 rounded-xl border border-line bg-bg p-2.5"
                  >
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-2">
                      <Icon name="file" class="size-4 text-ink-2" />
                    </span>
                    <span class="min-w-0">
                      <span class="block truncate text-xs font-medium">{attachment.name}</span>
                      <span class="block text-[10px] text-ink-2">{attachment.meta}</span>
                    </span>
                  </div>
                ))}
              </div>
            ),
        )
      }
      <div class="relative text-sm">
        <div class:list={["text-ink-2", typed.length > 0 && "fx-placeholder"]}>Write a message...</div>
        {
          typed.map(({ demo, timeline }) => (
            <div class="fx-typed absolute inset-0 overflow-hidden whitespace-pre" style={`--t-send:${timeline.sendAt ?? 0}ms`}>
              {demo.user?.skill && (
                <Fragment>
                  {/* The `/` sits where the chip will land; the chip holds the
                      slot, invisible, until the pick swaps them. */}
                  <span class="relative inline-block align-baseline">
                    <span class="fx-slash absolute left-0" style={`--d:${timeline.slashAt ?? 0}ms; --t-pick:${timeline.pickAt ?? 0}ms`}>
                      /
                    </span>
                    <span data-fx class="chip chip-skill gap-1 align-baseline" style={`--d:${timeline.pickAt ?? 0}ms`}>
                      <Icon name="zap" class="size-3" />
                      {demo.user.skill.picked}
                    </span>
                  </span>
                  {demo.user.text.trim() && " "}
                </Fragment>
              )}
              {[...(demo.user?.text ?? "").trim()].map((ch, ci) => (
                <span class="fx-char" style={`--d:${timeline.typeCharDelays[ci]}ms`}>{ch}</span>
              ))}
            </div>
          ))
        }
      </div>
      <div class="mt-4 flex items-center justify-between">
        <div class="flex items-center gap-2 text-ink-2">
          <Icon name="paperclip" class="size-4" />
          <span class="flex items-center gap-1 text-xs font-medium">
            Opus 5
            <Icon name="chevron-down" class="size-3.5 opacity-60" />
          </span>
        </div>
        <span
          class:list={[
            "flex size-7 items-center justify-center rounded-full bg-accent text-on-accent",
            typed.length > 0 && "fx-send",
          ]}
        >
          <Icon name="arrow-up" class="size-4" />
        </span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Global on purpose: `is-shown`/`is-active` are toggled at runtime, and
     Astro's scoped styles don't cover keyframes cleanly; everything is
     namespaced under .fdemo instead. Base styles are the final state of a
     scene; animations exist only under `.is-active`, and every one is
     `both`/`forwards`-filled, so the global reduced-motion rule (global.css)
     collapses an active scene to that same final state. */
  .fdemo .scene {
    display: none;
  }
  .fdemo .scene.is-shown {
    display: flex;
  }

  @keyframes fdemo-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes fdemo-hide {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes fdemo-shimmer {
    from {
      background-position: 150% 0;
    }
    to {
      background-position: -150% 0;
    }
  }

  .fdemo .scene.is-active [data-fx] {
    animation: fdemo-in 250ms var(--d, 0ms) both;
  }

  /* Assistant reply words: token-stream feel, a fast fade with no movement. */
  @keyframes fdemo-stream {
    from {
      opacity: 0;
    }
  }
  .fdemo .scene.is-active .fx-stream {
    animation: fdemo-stream 180ms var(--d, 0ms) both;
  }

  /* Composer typing: the typed text overlays the placeholder from the first
     character (--t-type) until the send (--t-send), when the composer clears,
     the send button presses, and the bubble lands in the thread. A second
     turn repeats the cycle with --t-type-2/--t-send-2; scenes without one
     leave those unset and the fallbacks never fire. */
  @keyframes fdemo-show {
    from {
      opacity: 0;
      visibility: visible;
    }
    to {
      opacity: 1;
      visibility: visible;
    }
  }
  @keyframes fdemo-press {
    50% {
      transform: scale(0.85);
    }
  }
  .fdemo .fx-typed,
  .fdemo .fx-cattach {
    display: none;
  }
  .fdemo .scene.is-active .fx-typed {
    display: block;
    animation: fdemo-hide 1ms var(--t-send, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-char {
    animation: fdemo-stream 1ms var(--d, 0ms) both;
  }
  /* The skill picker's `/`: typed like a character, gone at the pick, when
     the chip takes its place. */
  .fdemo .scene.is-active .fx-slash {
    animation:
      fdemo-stream 1ms var(--d, 0ms) both,
      fdemo-hide 1ms var(--t-pick, 0ms) forwards;
  }
  /* The skill picker exists only while the scene animates: it opens after
     the `/` and closes at the pick, so the final state has no popup. */
  .fdemo .fx-picker {
    display: none;
  }
  .fdemo .scene.is-active .fx-picker {
    display: block;
    animation:
      fdemo-in 250ms var(--d, 0ms) both,
      fdemo-hide 1ms var(--t-pick, 0ms) forwards;
  }
  /* A picker row's highlight: on when the highlight lands on the row, off
     when it moves to the next one; the picked row keeps it. */
  .fdemo .fx-highlight {
    opacity: 0;
  }
  .fdemo .scene.is-active .fx-highlight {
    animation:
      fdemo-show 1ms var(--d, 0ms) forwards,
      fdemo-hide 1ms var(--t-off, 1000000ms) forwards;
  }
  /* On send the card must also give up its layout space, not just fade, or
     the composer keeps a blank block where it used to be. */
  @keyframes fdemo-collapse {
    to {
      opacity: 0;
      visibility: hidden;
      max-height: 0;
      margin-bottom: 0;
      padding-top: 0;
      padding-bottom: 0;
      border-width: 0;
    }
  }
  .fdemo .scene.is-active .fx-cattach {
    display: flex;
    max-height: 12rem;
    overflow: hidden;
    animation: fdemo-collapse 1ms var(--t-send, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-placeholder {
    animation:
      fdemo-hide 1ms var(--t-type, 0ms) forwards,
      fdemo-show 150ms var(--t-send, 0ms) forwards,
      fdemo-hide 1ms var(--t-type-2, 1000000ms) forwards,
      fdemo-show 150ms var(--t-send-2, 1000000ms) forwards;
  }
  .fdemo .scene.is-active .fx-send {
    animation:
      fdemo-press 250ms var(--t-send, 0ms) both,
      fdemo-press 250ms var(--t-send-2, 1000000ms) both;
  }

  /* "Working" exists only while the scene animates; the final state shows
     "Worked for Ns". The shimmer sweeps the label until --t-done hides it. */
  .fdemo .fx-working {
    display: none;
  }
  .fdemo .scene.is-active .fx-working {
    display: inline-block;
    background-image: linear-gradient(90deg, var(--ink-2) 40%, var(--ink) 50%, var(--ink-2) 60%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      fdemo-in 200ms var(--d, 0ms) both,
      fdemo-shimmer 1.4s linear infinite,
      fdemo-hide 1ms var(--t-done, 0ms) forwards;
  }
  .fdemo .scene.is-active .fx-worked {
    animation: fdemo-in 200ms var(--t-done, 0ms) both;
  }

  /* Entity chips, the app's dusty per-kind colors (hardcoded there too). */
  .fdemo .chip {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    padding: 0.05rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
  }
  .fdemo .chip-account {
    background: #d4def0;
    color: #3f5685;
  }
  .fdemo .chip-payee {
    background: #d2e8db;
    color: #3f6e55;
  }
  .fdemo .chip-tag {
    background: #efe1cd;
    color: #856b41;
  }
  .fdemo .chip-skill {
    background: #e2dcee;
    color: #5c4a82;
  }
  @media (prefers-color-scheme: dark) {
    .fdemo .chip-account {
      background: #2c3850;
      color: #a7bdde;
    }
    .fdemo .chip-payee {
      background: #293d31;
      color: #a3c9b1;
    }
    .fdemo .chip-tag {
      background: #3f3626;
      color: #d8c096;
    }
    .fdemo .chip-skill {
      background: #342c47;
      color: #bcaedd;
    }
  }
</style>
